# Go HTTP service that mimics vLLM's public API surface and Prometheus
# metric families. v0.1 contents land here as:
#   main.go      - HTTP server + streaming /v1/chat/completions + /metrics
#   go.mod       - module declaration
#   Dockerfile   - distroless multi-arch (amd64 + arm64) image
#   README.md    - metric list + env knobs + local run instructions
#
# Metric families emitted (match real vLLM 0.6.x):
#   vllm:time_to_first_token_seconds (Histogram, buckets 0.01..30s)
#   vllm:time_per_output_token_seconds (Histogram, buckets 0.005..5s)
#   vllm:request_total (Counter, labels: model)
#   vllm:request_success_total (Counter, labels: model, status)
#   vllm:num_requests_running (Gauge)
#   vllm:num_requests_waiting (Gauge)
#   vllm:gpu_cache_usage_perc (Gauge, 0..1)
